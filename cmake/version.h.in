#ifndef GMP_VERSION_H_
#define GMP_VERSION_H_

#define GMP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define GMP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define GMP_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define GMP_VERSION_STRING "@PROJECT_VERSION@"

#define GMP_VERSION_CODE (GMP_VERSION_MAJOR * 10000 + \
                            GMP_VERSION_MINOR * 100 +  \
                            GMP_VERSION_PATCH)

#endif // GMP_VERSION_H_